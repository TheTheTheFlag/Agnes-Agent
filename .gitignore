# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/

# Virtual environments
.venv
.env

# 编辑器 / IDE 配置
.idea/
.vscode/

# 运行时数据（Agent 记忆/会话，不进版本库）
data/*.db
data/*.db-shm
data/*.db-wal
data/*.bak
data/.model_config
# L6 知识图谱持久化（每会话一个子目录），不入仓
lightrag_storage/
# 本地 Neo4j 运行环境（JDK + 图数据库），不入仓
neo4j/
.runtime/
# 面板登录凭据（首次设置时写入；PBKDF2 哈希，不含明文）
# 注意：gitignore 不支持行尾注释，规则与说明必须各占一行，否则整行会被当成路径模式
data/auth.json
data/auth.json.tmp
# 持久化 trace 文件（每会话一个 JSONL），不入仓
data/traces/

# 本地状态与日志
.thread_id
*.log
identifier.sqlite
system_commands.log

# 调试面板本地静态缓存
app/server/static/marked.min.js

# 图片创作工作台作品库（原图 + 缩略图 + manifest）
data/image_library/

# 用户上传文件
uploads/
# 每用户隔离数据（db/上传/交付物/RAG/技能），绝不入库
data/users/
# 交付物（运行时产物）
deliverables/

# ============ 服务器 auto-snapshot 曾把运行时产物误入库，统一剔除 ============
# 内部访问令牌（跨服务调用用，属凭证，绝不公开）
data/internal_token
# 服务/管道运行日志与状态文件
logs/
tools_deliver/
err.txt
.gates.jsonl
*.bak*
# 历史技能交付补丁备份（已被 short-drama-director / drama-pipeline 取代）
app/skills/.deliverdir-patch*/

# one-off generator scripts (runtime artifact, do not commit)
generate_e02.py


